# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Deterministic replay outputs.
# Regenerated by the scripts/verify_*.py family and by
# scripts/analyze_paper_b_*.py.
# Pin these to a release or attach them to the submission commit rather
# than tracking them on a working branch.
artifacts/

# Generated manuscript sources.
# scripts/render_paper_b_figures.py assembles these from the schema v5
# benchmark; they are derived from paper_b_main.tex and
# paper_b_reviewer_sections.tex, which are the tracked sources.
manuscript/generated/
manuscript/paper_b_compiled.tex

# LaTeX build products
manuscript/*.pdf
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.toc
